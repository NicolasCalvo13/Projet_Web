{
    "name": "cesi/projet-stages",
    "description": "Plateforme de gestion des offres de stage (MVC PHP + Twig).",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
